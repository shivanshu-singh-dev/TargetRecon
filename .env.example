# Algorithm-Optimized Reconnaissance Framework Configuration
# Copy this file to .env and populate credentials if using external indexed APIs.
# None of these keys are required for the framework or its DAA coursework demonstrations.

# Optional Shodan API Key (https://developer.shodan.io/)
SHODAN_API_KEY=

# Optional Censys API Credentials (https://search.censys.io/account/api)
CENSYS_API_ID=
CENSYS_API_SECRET=

# Network and Rate Limiting Settings
RECON_TIMEOUT_SECONDS=5.0
RECON_MAX_RETRIES=2
RECON_RATE_LIMIT_DELAY=0.5
RECON_MAX_BANNER_BYTES=2048
RECON_DEFAULT_BUDGET=15
